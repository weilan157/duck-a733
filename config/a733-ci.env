# CI 用的 BSP 配置覆盖（A733 / Cubie A7Z）
#
# 与 weilan157/bsp 仓库里的 config.env 一样，只是把"国内代理前缀"去掉：
# GitHub runner 直连 github.com，走 ghfast.top 反而多一跳、还可能 5xx。
# 用法（在 BSP 目录里）：
#   while IFS='=' read -r k v; do [ -n "$k" ] && ./bsp config "$k=$v"; done < config/a733-ci.env

PLATFORM="a733"

# ---- 上游源码（直连）----
A733_UBOOT_REPO="https://github.com/radxa/u-boot.git"
A733_UBOOT_BRANCH="cubie-aiot-v1.4.6"
A733_KERNEL_SRC_REPO="https://github.com/radxa/kernel.git"
A733_KERNEL_SRC_BRANCH="allwinner-aiot-linux-6.6"
A733_BSP_REPO="https://github.com/radxa/allwinner-bsp.git"
A733_BSP_BRANCH="cubie-aiot-v1.4.8"
A733_DEVICE_REPO="https://github.com/radxa/allwinner-device.git"
A733_DEVICE_BRANCH="device-a733-v1.4.8"

A733_DTS_NAME="sun60i-a733-cubie-a7z"
A733_CROSS_COMPILE="aarch64-linux-gnu-"
A733_BRANDY_DEFCONFIG="sun60iw2p1_a733_defconfig"
A733_IMAGE_NAME="a733-micro.img"

# runner 一般 4 核；-j6 在 16GB 上容易 OOM，降到 4
MAKE_JOBS="4"

# ---- rootfs ----
ROOTFS_TYPE=micro
ROOTFS_HOSTNAME=a733
ROOTFS_ROOT_PASSWORD=root
ROOTFS_USER=debian
ROOTFS_USER_PASSWORD=debian
KERNEL_MODULES_INSTALL=y

DEBIAN_RELEASE=trixie
DEBIAN_ARCH=arm64
DEBIAN_MIRROR=deb.debian.org
DEBIAN_VARIANT=minbase

A733_DEBUG_UART=uart4
A733_ROOTFS_INIT=systemd
